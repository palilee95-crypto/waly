# Public hostnames served by Caddy
DOMAIN_API=api.risev.app
DOMAIN_API_STAGING=staging-api.risev.app

# SMTP Server Settings (Resend / Email Notifications)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_SENDER=noreply@risev.app
SMTP_SENDER_NAME=RISEV

# Litestream offsite backup (Cloudflare R2)
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET=risev-pb-backup
S3_REGION=auto

# Frontend Configuration (Expo)
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_PB_URL=https://api.risev.app
EXPO_PUBLIC_META_APP_ID=1040853298682209
# Chip In Payment Gateway
CHIPIN_BRAND_ID=your_chipin_brand_id
CHIPIN_API_KEY=your_chipin_live_api_key
CHIPIN_WEBHOOK_PUBLIC_KEY=your_chipin_webhook_public_key

# Web Push VAPID Configuration (Self-Hosted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@risev.app


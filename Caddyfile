# API PocketBase Reverse Proxy
#
# IMPORTANT: proxy by CONTAINER name, not by compose service name. Two compose
# projects (prod + /opt/risev-staging) share risev_risev-network; when both had a
# service called "pocketbase", Docker DNS round-robined Caddy between the two
# containers and roughly half of production traffic hit staging.
{$DOMAIN_API} {
    reverse_proxy risev-pocketbase:8090 {
        header_up X-Real-IP {header.CF-Connecting-IP}
    }

    log {
        # Bounded: 10 MB per file, 5 files, ~50 MB max.
        output file /data/logs/access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Staging API — same rules, disposable database (/opt/risev-staging).
# Caddy reads DOMAIN_API_STAGING at start; after changing it run
# `docker compose up -d caddy`.
{$DOMAIN_API_STAGING} {
    reverse_proxy risev-pocketbase-staging:8090 {
        header_up X-Real-IP {header.CF-Connecting-IP}
    }

    log {
        output file /data/logs/access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/_expo/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/.*\\.html$",
      "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/_expo/.*", "status": 404 },
    { "src": "/assets/.*", "status": 404 },
    { "src": "/.*\\.(js|mjs|css|map|json|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|otf)$", "status": 404 },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" }
    }
  ]
}
